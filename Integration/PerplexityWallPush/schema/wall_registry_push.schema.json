{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/wall_registry_push.schema.json",
  "title": "Wall Registry Push Payload",
  "type": "object",
  "required": [
    "room_id",
    "wall_id",
    "units",
    "expected_total_width",
    "source_app",
    "schema_version",
    "updated_at",
    "segments"
  ],
  "properties": {
    "room_id": {
      "type": "string",
      "minLength": 1
    },
    "wall_id": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "enum": ["inches", "feet", "millimeters", "centimeters"]
    },
    "expected_total_width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source_app": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "vertical": {
      "$ref": "#/$defs/vertical_references"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["global_id", "kind", "label", "width"],
      "properties": {
        "global_id": {
          "type": "string",
          "minLength": 1
        },
        "local_id": {
          "type": ["string", "null"]
        },
        "kind": {
          "type": "string",
          "enum": ["column", "bookcase", "shelf", "return", "casing", "window", "door", "opening", "wall", "unknown"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "panel_split": {
          "type": ["array", "null"],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "notes": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "vertical_references": {
      "type": "object",
      "properties": {
        "ceiling_height": {
          "type": ["number", "null"]
        },
        "beam_bottom": {
          "type": ["number", "null"]
        },
        "beam_zone_height": {
          "type": ["number", "null"]
        },
        "sill_or_base_reference": {
          "type": ["number", "null"]
        },
        "window_head": {
          "type": ["number", "null"]
        },
        "header_top": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
