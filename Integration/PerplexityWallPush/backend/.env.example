PORT=8787

# Optional. Keep this server-side only. Never put this in Swift or Working Copy screenshots.
PPLX_API_KEY=

# Optional. If set, backend will ask Perplexity to summarize the pushed registry.
PPLX_API_URL=https://api.perplexity.ai/chat/completions
PPLX_MODEL=sonar

# Optional lightweight shared secret for your Swift app.
# If set, Swift must send header: X-Wall-Push-Token: <value>
WALL_PUSH_TOKEN=
